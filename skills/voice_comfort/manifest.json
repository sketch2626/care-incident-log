{
  "contract": 1,
  "name": "voice_comfort",
  "version": "0.1.0",
  "title": "Voice comfort",
  "summary": "Makes Mary's voice slower, faster, quieter or louder, switches between Mary and Sam, and turns listening for their name on or off.",
  "instructions": "Use when they ask you to talk slower, faster, quieter or louder, or to switch between Mary and Sam. If you cut them off, use more_time; if you can answer faster, use less_time. To stop or start listening for your name (Hey Mary / Hey Sam), use stop_wake or start_wake. Do these by voice, then ask if that is better.",
  "sees": true,
  "settings": ["voice_rate", "voice_volume", "companion", "listen_wait", "wake_word"],
  "actions": [
    {
      "name": "slower",
      "description": "Make Mary's voice a little slower.",
      "always": true,
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["slow down", "speak slower", "talk slower", "slower please"]
    },
    {
      "name": "faster",
      "description": "Make Mary's voice a little faster.",
      "always": true,
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["speed up", "talk faster", "speak faster"]
    },
    {
      "name": "quieter",
      "description": "Make Mary's voice a little quieter.",
      "always": true,
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["quieter", "not so loud", "turn it down"]
    },
    {
      "name": "louder",
      "description": "Make Mary's voice a little louder.",
      "always": true,
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["louder", "speak up", "turn it up", "i can't hear you"]
    },
    {
      "name": "more_time",
      "description": "Wait longer before answering, when they say you cut them off.",
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["give me more time", "you're cutting me off", "you keep cutting me off", "stop cutting me off", "wait for me to finish", "let me finish"]
    },
    {
      "name": "less_time",
      "description": "Answer a little quicker, when they say you can answer faster.",
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["you can answer faster", "answer faster", "you can answer quicker"]
    },
    {
      "name": "stop_wake",
      "description": "Stop listening for their name (Hey Mary / Hey Sam) until they ask again.",
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["stop listening for my name", "stop listening for your name", "don't listen for your name", "stop listening for hey mary", "stop listening for hey sam"]
    },
    {
      "name": "start_wake",
      "description": "Listen for their name again.",
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["listen for my name again", "listen for your name again", "start listening for your name", "listen for hey mary", "listen for hey sam"]
    },
    {
      "name": "switch_companion",
      "description": "Switch between Mary and Sam.",
      "inputSchema": {"type": "object", "properties": {}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false},
      "offline_phrases": ["switch to sam", "switch to mary", "let me talk to sam", "let me talk to mary"]
    }
  ],
